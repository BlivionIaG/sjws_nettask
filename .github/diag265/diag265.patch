diff --git a/tests/sjws_nettask/DiagCpu.java b/tests/sjws_nettask/DiagCpu.java
new file mode 100644
index 0000000..1282d5a
--- /dev/null
+++ b/tests/sjws_nettask/DiagCpu.java
@@ -0,0 +1,64 @@
+package sjws_nettask;
+
+import java.lang.management.ManagementFactory;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Issue #265 diagnostics: per-thread CPU deltas over a window (platform threads only). */
+final class DiagCpu {
+    private final Map<Long, Long> start = new HashMap<>();
+    private final Map<Long, String> names = new HashMap<>();
+    private final long proc0;
+
+    private static volatile boolean hogsStarted;
+    static volatile long sink;
+
+    /** -Ddiag265.hog=N: N busy daemon threads, standing in for unrelated CPU load in the shared test JVM. */
+    private static synchronized void hogs() {
+        String e = System.getenv("DIAG265_HOG"); int n = e == null ? Integer.getInteger("diag265.hog", 0) : Integer.parseInt(e);
+        if (hogsStarted || n <= 0) return;
+        hogsStarted = true;
+        for (int i = 0; i < n; i++) {
+            var t = new Thread(() -> { long x = 0; while (true) { x++; if ((x & 0xffffff) == 0) sink = x; } }, "diag-hog-" + i);
+            t.setDaemon(true);
+            t.start();
+        }
+    }
+
+    DiagCpu() {
+        hogs();
+        var mx = ManagementFactory.getThreadMXBean();
+        for (var info : mx.dumpAllThreads(false, false)) {
+            start.put(info.getThreadId(), mx.getThreadCpuTime(info.getThreadId()));
+            names.put(info.getThreadId(), info.getThreadName());
+        }
+        proc0 = ((com.sun.management.OperatingSystemMXBean) ManagementFactory.getOperatingSystemMXBean()).getProcessCpuTime();
+    }
+
+    String report(String label) {
+        var mx = ManagementFactory.getThreadMXBean();
+        long proc = ((com.sun.management.OperatingSystemMXBean) ManagementFactory.getOperatingSystemMXBean()).getProcessCpuTime() - proc0;
+        var sb = new StringBuilder("DIAG265 ").append(label).append(" proc=").append(proc / 1_000_000).append("ms");
+        long sum = 0;
+        var rows = new java.util.ArrayList<String>();
+        var groups = new java.util.TreeMap<String, Long>();
+        for (var info : mx.dumpAllThreads(false, false)) {
+            long id = info.getThreadId();
+            long now = mx.getThreadCpuTime(id);
+            if (now < 0) continue;
+            long d = now - start.getOrDefault(id, 0L);
+            sum += d;
+            String g = info.getThreadName().replaceAll("[0-9]+", "#");
+            groups.merge(g, d, Long::sum);
+            if (d > 5_000_000) rows.add(String.format("%s=%dms", info.getThreadName(), d / 1_000_000));
+        }
+        sb.append(" javaThreads=").append(sum / 1_000_000).append("ms (rest = GC/JIT/VM threads)");
+        sb.append(" threadCount=").append(mx.getThreadCount());
+        sb.append(" top=").append(rows);
+        var g = new java.util.ArrayList<>(groups.entrySet());
+        g.sort((a, b) -> Long.compare(b.getValue(), a.getValue()));
+        sb.append(" groups=").append(g.subList(0, Math.min(8, g.size())));
+        sb.append(" ").append(ChannelOutput.diag());
+        return sb.toString();
+    }
+}
