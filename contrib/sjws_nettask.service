# systemd unit for sjws_nettask (Type=forking: --daemon writes PIDFile, then the parent exits).
# Install the jar and its target/lib/ directory together (the manifest Class-Path is lib/).
# Adjust the document root and the port, and add User= if the service should not run as root.
# TimeoutStopSec is longer than the default --shutdown-timeout (10s) plus the 5s --stop margin.
#
#   install -D -m 0644 contrib/sjws_nettask.service /etc/systemd/system/sjws_nettask.service
#   systemctl daemon-reload && systemctl enable --now sjws_nettask

[Unit]
Description=sjws_nettask static file server
After=network.target

[Service]
Type=forking
PIDFile=/run/sjws_nettask.pid
ExecStart=/usr/bin/java -jar /usr/share/sjws_nettask/sjws_nettask.jar --daemon --pid-file=/run/sjws_nettask.pid --log-file=/var/log/sjws_nettask.log --shutdown-timeout=10 8080 /var/www/html
ExecStop=/usr/bin/java -jar /usr/share/sjws_nettask/sjws_nettask.jar --stop --pid-file=/run/sjws_nettask.pid --shutdown-timeout=10
ExecReload=/usr/bin/java -jar /usr/share/sjws_nettask/sjws_nettask.jar --restart --pid-file=/run/sjws_nettask.pid --log-file=/var/log/sjws_nettask.log --shutdown-timeout=10 8080 /var/www/html
Restart=on-failure
TimeoutStopSec=30
WorkingDirectory=/var/www/html

[Install]
WantedBy=multi-user.target
