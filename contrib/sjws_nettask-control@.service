# systemd template for a sjws_nettask control-plane node.
#   systemctl enable --now sjws_nettask-control@1
#
# Create the account and the bootstrap before the first start:
#   useradd --system --home /var/lib/sjws_nettask --shell /usr/sbin/nologin sjws
#   install -d -m 0750 -o root -g sjws /etc/sjws_nettask/control-1
# Bootstrap layout, file modes, and the lifecycle notes:
#   docs/operations/control-plane-service.md
#
# The join token and the pin live in files named by the bootstrap. They are not arguments.
# Type=forking matches the standalone unit: --daemon writes PIDFile, then the parent exits.
# Active means the content port is bound, not that the node is leader-ready.
# Do not Requires= a data unit. Stopping this node must not stop data nodes.
# No ExecReload: the daemon child ignores SIGHUP, and --restart would re-read the join token.
#
# TimeoutStopSec covers Lifecycle.drain() (default delay 5s + drain 15s) plus
# --shutdown-timeout 10s, close slack, and the 5s --stop margin.
#
#   install -D -m 0644 contrib/sjws_nettask-control@.service /etc/systemd/system/sjws_nettask-control@.service
#   systemctl daemon-reload

[Unit]
Description=sjws_nettask control plane node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=sjws
Group=sjws
UMask=0077
PIDFile=/run/sjws_nettask/control-%i.pid
RuntimeDirectory=sjws_nettask
StateDirectory=sjws_nettask
LogsDirectory=sjws_nettask
WorkingDirectory=/var/lib/sjws_nettask
ExecStart=/usr/bin/java -XX:-HeapDumpOnOutOfMemoryError -jar /usr/share/sjws_nettask/sjws_nettask.jar --daemon --role=control --bootstrap=/etc/sjws_nettask/control-%i/bootstrap --pid-file=/run/sjws_nettask/control-%i.pid --log-file=/var/log/sjws_nettask/control-%i.log --shutdown-timeout=10 8080 /var/www/html
ExecStop=/usr/bin/java -jar /usr/share/sjws_nettask/sjws_nettask.jar --stop --pid-file=/run/sjws_nettask/control-%i.pid --shutdown-timeout=10
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
