<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>sjws_nettask</groupId>
  <artifactId>sjws_nettask</artifactId>
  <version>0.2-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- Run only the green suite with: mvn test -DexcludedGroups=bug -->
    <excludedGroups></excludedGroups>
    <netty.version>4.2.19.Final</netty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- HTTP/3 (QUIC). Its POM already pulls the native quiche jars for linux-x86_64, linux-aarch_64,
         osx-x86_64, osx-aarch_64 and windows-x86_64 as runtime dependencies (see the HTTP/3 design §1). -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Keep the existing NetBeans layout (src/sjws_nettask/...) -->
    <sourceDirectory>src</sourceDirectory>
    <!-- test/ is in .gitignore, so tests live in tests/ -->
    <testSourceDirectory>tests</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>
      </plugin>
      <!-- Coverage (W1/W5): agent for unit + in-process integration tests, report at
           target/site/jacoco, gate enforced by `mvn verify`. Subprocess tests are not instrumented. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- Gate: per-package rules (measured 2026-10-12, set ~3 pts below). Only the packages
               listed are gated, so sjws_nettask.h3 is not, until the h3-transport merge adds its rule. -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.core</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.87</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.78</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.HTTP</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.88</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.78</minimum></limit>
                </limits>
              </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive><manifest><mainClass>sjws_nettask.Sjws_nettask</mainClass></manifest></archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
