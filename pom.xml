<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>sjws_nettask</groupId>
  <artifactId>sjws_nettask</artifactId>
  <version>0.2-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Default for @{argLine} when the JaCoCo agent isn't set (e.g. -Djacoco.skip). -->
    <argLine></argLine>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>6.1.3</junit.version>
    <!-- Run only the green suite with: mvn test -DexcludedGroups=bug -->
    <excludedGroups></excludedGroups>
    <netty.version>4.2.19.Final</netty.version>
    <!-- Coverage gate for the h3 and tls packages. Their tests need the QUIC natives, which Netty ships
         only for linux-x86_64/aarch64, osx-x86_64/aarch64 and windows-x86_64; the h3-gate-* profiles
         below raise these on exactly those platforms. Elsewhere the h3 tests skip themselves and the gate
         is 0. On a supported platform where the natives still can't load (e.g. a noexec /tmp), run with
         -Dh3.gate.line=0 -Dh3.gate.branch=0 -Dtls.gate.line=0 -Dtls.gate.branch=0. -->
    <h3.gate.line>0</h3.gate.line>
    <h3.gate.branch>0</h3.gate.branch>
    <tls.gate.line>0</tls.gate.line>
    <tls.gate.branch>0</tls.gate.branch>
    <bouncycastle.version>1.86</bouncycastle.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Bouncy Castle comes in through acme4j-client (which pins 1.83). Override it until acme4j
           releases with a fixed version: 1.83 has CVE-2025-14813, CVE-2026-0636, CVE-2026-5588,
           CVE-2026-5598, CVE-2026-8763 and CVE-2026-13506 (fixed in 1.84/1.85). -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcutil-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- HTTP/3 (QUIC). Its POM already pulls the native quiche jars for linux-x86_64, linux-aarch_64,
         osx-x86_64, osx-aarch_64 and windows-x86_64 as runtime dependencies (see the HTTP/3 design §1). -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http3</artifactId>
    </dependency>
    <!-- HTTP/2 (TLS with ALPN, h2c): same Netty version as HTTP/3, via the BOM. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http2</artifactId>
    </dependency>
    <!-- One config file. YAML, because the routing workstream's schema is YAML and must
         paste in unchanged. SafeConstructor only: no arbitrary types. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.7</version>
    </dependency>
    <!-- ACME (RFC 8555). HTTP-01 issuance and renewal. -->
    <dependency>
      <groupId>org.shredzone.acme4j</groupId>
      <artifactId>acme4j-client</artifactId>
      <version>5.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Keep the existing NetBeans layout (src/sjws_nettask/...) -->
    <sourceDirectory>src</sourceDirectory>
    <!-- test/ is in .gitignore, so tests live in tests/ -->
    <testSourceDirectory>tests</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <excludedGroups>jar,${excludedGroups}</excludedGroups>
          <workingDirectory>${project.basedir}</workingDirectory>
          <!-- @{argLine} keeps the JaCoCo agent; native access for Netty's QUIC natives (JEP 472). -->
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED</argLine>
        </configuration>
        <executions>
          <!-- Tests tagged "jar" run the packaged jar (java -jar target/sjws_nettask-*.jar), so they run
               after `package`. No JaCoCo agent here: it would overwrite the unit-test execution data. -->
          <execution>
            <id>jar-tests</id>
            <phase>integration-test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>jar</groups>
              <!-- Non-empty values: an empty element would inherit the plugin-level config. -->
              <excludedGroups>bug-only-placeholder,${excludedGroups}</excludedGroups>
              <argLine>-Dsjws.jarTests=true --enable-native-access=ALL-UNNAMED</argLine>
              <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage (W1/W5): agent for unit + in-process integration tests, report at
           target/site/jacoco, gate enforced by `mvn verify`. Subprocess tests are not instrumented. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <!-- Fresh data every build: stale runs must not inflate coverage. -->
            <configuration><append>false</append></configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- Gate: per-package rules, set ~1-2 points under measured coverage (2026-10-12),
               except the restored root branch floor of 0.96 and the acme branch floor of
               0.85 (measured 91.1/85.8). config is 86.2/75.0; its branch floor stays 0.73
               because 159 of the 181 missed branches are ConfigLoader's strict YAML error
               matrix, which is not on the request path. gateway is 90.4/77.7;
               the branch floor stays 0.76 because the misses are malformed JWT, DER and
               JSON rejects. -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.core.buf</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.messaging.stats</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.messaging.delivery</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.messaging.ledger</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.observe</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.86</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.cluster</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.78</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.controlplane</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.ha</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.84</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.core</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.94</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.89</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.http1</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.98</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.97</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.96</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.96</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.h2</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.92</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.83</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.admin.cp</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.admin</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.92</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.h3</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${h3.gate.line}</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${h3.gate.branch}</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.config</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.81</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.73</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.acme</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.tls</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${tls.gate.line}</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${tls.gate.branch}</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.gateway</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.88</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.76</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.service</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.swarm</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.swarm.wire</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.cp</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.routing</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.routing.discovery</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                </limits>
              </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <!-- Runnable with `java -jar target/sjws_nettask-<version>.jar`: dependencies (Netty + the
               QUIC natives) are copied to target/lib and listed in the manifest Class-Path. -->
          <archive>
            <manifest>
              <mainClass>sjws_nettask.Sjws_nettask</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
            <manifestEntries>
              <!-- JDK 22+: lets Netty load the QUIC natives without a warning (blocked in future JDKs). -->
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-runtime-deps</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing: mvn -P pitest test-compile org.pitest:pitest-maven:mutationCoverage (slow: not part of verify) -->
    <profile>
      <id>pitest</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.30.0</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>sjws_nettask.*</param>
              </targetClasses>
              <targetTests>
                <param>sjws_nettask.*</param>
              </targetTests>
              <excludedGroups>
                <param>jar</param>
              </excludedGroups>
              <threads>4</threads>
              <timeoutConstant>8000</timeoutConstant>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- One per platform with Netty QUIC natives (activation conditions are ANDed, so one each). -->
    <profile>
      <id>h3-gate-linux-x86_64</id>
      <activation><os><name>linux</name><arch>amd64</arch></os></activation>
      <properties>
        <h3.gate.line>0.94</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.95</tls.gate.line><tls.gate.branch>0.93</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-linux-aarch64</id>
      <activation><os><name>linux</name><arch>aarch64</arch></os></activation>
      <properties>
        <h3.gate.line>0.94</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.95</tls.gate.line><tls.gate.branch>0.93</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-mac-x86_64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <h3.gate.line>0.94</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.95</tls.gate.line><tls.gate.branch>0.93</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-mac-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <h3.gate.line>0.94</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.95</tls.gate.line><tls.gate.branch>0.93</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-windows-x86_64</id>
      <activation><os><family>windows</family><arch>amd64</arch></os></activation>
      <properties>
        <h3.gate.line>0.94</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.95</tls.gate.line><tls.gate.branch>0.93</tls.gate.branch>
      </properties>
    </profile>
  </profiles>
</project>
