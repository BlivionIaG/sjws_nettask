<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>sjws_nettask</groupId>
  <artifactId>sjws_nettask</artifactId>
  <version>0.2-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- Run only the green suite with: mvn test -DexcludedGroups=bug -->
    <excludedGroups></excludedGroups>
    <netty.version>4.2.19.Final</netty.version>
    <!-- Coverage gate for the h3 and tls packages. Their tests need the QUIC natives, which Netty ships
         only for linux-x86_64/aarch64, osx-x86_64/aarch64 and windows-x86_64; the h3-gate-* profiles
         below raise these on exactly those platforms. Elsewhere the h3 tests skip themselves and the gate
         is 0. On a supported platform where the natives still can't load (e.g. a noexec /tmp), run with
         -Dh3.gate.line=0 -Dh3.gate.branch=0 -Dtls.gate.line=0 -Dtls.gate.branch=0. -->
    <h3.gate.line>0</h3.gate.line>
    <h3.gate.branch>0</h3.gate.branch>
    <tls.gate.line>0</tls.gate.line>
    <tls.gate.branch>0</tls.gate.branch>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- HTTP/3 (QUIC). Its POM already pulls the native quiche jars for linux-x86_64, linux-aarch_64,
         osx-x86_64, osx-aarch_64 and windows-x86_64 as runtime dependencies (see the HTTP/3 design §1). -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Keep the existing NetBeans layout (src/sjws_nettask/...) -->
    <sourceDirectory>src</sourceDirectory>
    <!-- test/ is in .gitignore, so tests live in tests/ -->
    <testSourceDirectory>tests</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <excludedGroups>jar,${excludedGroups}</excludedGroups>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>
        <executions>
          <!-- Tests tagged "jar" run the packaged jar (java -jar target/sjws_nettask-*.jar), so they run
               after `package`. No JaCoCo agent here: it would overwrite the unit-test execution data. -->
          <execution>
            <id>jar-tests</id>
            <phase>integration-test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>jar</groups>
              <!-- Non-empty values: an empty element would inherit the plugin-level config. -->
              <excludedGroups>bug-only-placeholder,${excludedGroups}</excludedGroups>
              <argLine>-Dsjws.jarTests=true</argLine>
              <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage (W1/W5): agent for unit + in-process integration tests, report at
           target/site/jacoco, gate enforced by `mvn verify`. Subprocess tests are not instrumented. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <!-- Fresh data every build: stale runs must not inflate coverage. -->
            <configuration><append>false</append></configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- Gate: per-package rules (measured 2026-10-12, set ~2-3 pts below). Every production
               package is gated; h3 (92.5/91.5) and tls (93.1/94.1) were measured on the merged http3 branch. -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.core</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.87</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.78</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.http1</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.88</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.78</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.h3</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${h3.gate.line}</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${h3.gate.branch}</minimum></limit>
                </limits>
              </rule>
              <rule>
                <element>PACKAGE</element>
                <includes><include>sjws_nettask.tls</include></includes>
                <limits>
                  <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${tls.gate.line}</minimum></limit>
                  <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${tls.gate.branch}</minimum></limit>
                </limits>
              </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <!-- Runnable with `java -jar target/sjws_nettask-<version>.jar`: dependencies (Netty + the
               QUIC natives) are copied to target/lib and listed in the manifest Class-Path. -->
          <archive>
            <manifest>
              <mainClass>sjws_nettask.Sjws_nettask</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>copy-runtime-deps</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Mutation testing: mvn -P pitest test-compile org.pitest:pitest-maven:mutationCoverage (slow: not part of verify) -->
    <profile>
      <id>pitest</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.17.4</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.1</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>sjws_nettask.*</param>
              </targetClasses>
              <targetTests>
                <param>sjws_nettask.*</param>
              </targetTests>
              <excludedGroups>
                <param>jar</param>
              </excludedGroups>
              <threads>4</threads>
              <timeoutConstant>8000</timeoutConstant>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- One per platform with Netty QUIC natives (activation conditions are ANDed, so one each). -->
    <profile>
      <id>h3-gate-linux-x86_64</id>
      <activation><os><name>linux</name><arch>amd64</arch></os></activation>
      <properties>
        <h3.gate.line>0.90</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.90</tls.gate.line><tls.gate.branch>0.91</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-linux-aarch64</id>
      <activation><os><name>linux</name><arch>aarch64</arch></os></activation>
      <properties>
        <h3.gate.line>0.90</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.90</tls.gate.line><tls.gate.branch>0.91</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-mac-x86_64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <h3.gate.line>0.90</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.90</tls.gate.line><tls.gate.branch>0.91</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-mac-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <h3.gate.line>0.90</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.90</tls.gate.line><tls.gate.branch>0.91</tls.gate.branch>
      </properties>
    </profile>
    <profile>
      <id>h3-gate-windows-x86_64</id>
      <activation><os><family>windows</family><arch>amd64</arch></os></activation>
      <properties>
        <h3.gate.line>0.90</h3.gate.line><h3.gate.branch>0.89</h3.gate.branch>
        <tls.gate.line>0.90</tls.gate.line><tls.gate.branch>0.91</tls.gate.branch>
      </properties>
    </profile>
  </profiles>
</project>
